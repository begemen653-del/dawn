# Copy this file to .env.local (same folder) and paste your keys after the = signs.
# .env.local is git-ignored: it never leaves your PC. On GitHub the same names go into
# Settings → Secrets and variables → Actions.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional (free models are limited to 50 requests a day):
OPENROUTER_API_KEY=

# Optional overrides (comma-separated model lists, daily token cap):
# DAWN_GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# DAWN_GROQ_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,moonshotai/kimi-k2-instruct,llama-3.3-70b-versatile
# DAWN_AI_TOKEN_BUDGET=1500000
