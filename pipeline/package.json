{
  "name": "@dawn/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema/index.ts",
    "./images/license": "./src/images/license.ts"
  },
  "scripts": {
    "dry": "node --max-old-space-size=2048 --import tsx src/run/index.ts --dry",
    "typecheck": "tsc -p .",
    "ingest": "node --max-old-space-size=2048 --import tsx src/run/index.ts --ingest",
    "live": "node --max-old-space-size=2048 --import tsx src/run/index.ts --live",
    "mock": "node --max-old-space-size=2048 --import tsx src/run/index.ts --mock",
    "check-ai": "tsx src/run/check-ai.ts"
  },
  "dependencies": {
    "@dawn/config": "*",
    "@mozilla/readability": "^0.6.0",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1"
  }
}
